{
  "name": "@folio/bookings",
  "version": "1.0.0",
  "description": "FOLIO Bookings app — create and manage item booking records",
  "main": "src/index.js",
  "repository": "folio-org/ui-bookings",
  "publishConfig": {
    "registry": "https://repository.folio.org/repository/npm-folio/"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "stripes serve",
    "build": "stripes build --output ./output",
    "lint": "eslint .",
    "test": "yarn run test:jest",
    "test:jest": "jest --ci --coverage --maxWorkers=50%",
    "build-mod-descriptor": "stripes mod descriptor --full --strict | jq '.[]' > module-descriptor.json",
    "formatjs-compile": "stripes translate compile"
  },
  "stripes": {
    "actsAs": [
      "app",
      "settings"
    ],
    "displayName": "ui-bookings.meta.title",
    "route": "/bookings",
    "home": "/bookings",
    "queryResource": "query",
    "icons": [
      {
        "name": "app",
        "alt": "Create and manage item bookings",
        "title": "Bookings"
      }
    ],
    "okapiInterfaces": {
      "bookings": "1.0",
      "users": "16.1",
      "inventory": "10.0 11.0 12.0 13.0",
      "circulation": "9.0 10.0 11.0 12.0 13.0 14.0",
      "settings": "1.1"
    },
    "optionalOkapiInterfaces": {
      "bookings-storage": "1.0"
    },
    "permissionSets": [
      {
        "permissionName": "module.bookings.enabled",
        "displayName": "UI: Bookings module is enabled",
        "visible": false
      },
      {
        "permissionName": "ui-bookings.view",
        "displayName": "Bookings: View bookings",
        "description": "View booking records",
        "subPermissions": [
          "module.bookings.enabled",
          "bookings.bookings.view",
          "users.item.get",
          "users.collection.get",
          "inventory.items.item.get",
          "inventory.items.collection.get",
          "inventory-storage.holdings.collection.get",
          "inventory-storage.service-points.collection.get"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.create-edit",
        "displayName": "Bookings: Create and edit bookings",
        "description": "Create and modify booking records, including triggering recalls",
        "subPermissions": [
          "ui-bookings.view",
          "bookings.bookings.create-edit"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.delete",
        "displayName": "Bookings: Delete bookings",
        "description": "Delete booking records",
        "subPermissions": [
          "ui-bookings.view",
          "bookings.bookings.delete"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.override-availability",
        "displayName": "Bookings: Override item availability",
        "description": "Allow booking of items regardless of current loan status",
        "subPermissions": [
          "ui-bookings.create-edit",
          "bookings.bookings.override-availability"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.events.manage",
        "displayName": "Bookings: Manage events",
        "description": "Create, edit and delete events that bookings can be linked to",
        "subPermissions": [
          "ui-bookings.view",
          "bookings.events.manage"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.activate",
        "displayName": "Bookings: Activate bookings",
        "description": "Manually check out the items of a booking before its start time",
        "subPermissions": [
          "ui-bookings.view",
          "bookings.bookings.activate"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.override-limit",
        "displayName": "Bookings: Override booking limit",
        "description": "Create bookings beyond the patron group's booking limit",
        "subPermissions": [
          "ui-bookings.create-edit",
          "bookings.bookings.override-limit"
        ],
        "visible": true
      },
      {
        "permissionName": "ui-bookings.settings.manage",
        "displayName": "Settings (Bookings): Manage settings",
        "description": "View and change booking limits, recall lead time and checkout lead time",
        "subPermissions": [
          "settings.bookings.enabled",
          "bookings.settings.manage",
          "usergroups.collection.get"
        ],
        "visible": true
      },
      {
        "permissionName": "settings.bookings.enabled",
        "displayName": "Settings (Bookings): display list of settings pages",
        "subPermissions": [
          "settings.enabled"
        ],
        "visible": false
      }
    ]
  },
  "dependencies": {
    "react-final-form": "^6.5.9",
    "final-form": "^4.20.9",
    "final-form-arrays": "^3.0.2",
    "react-final-form-arrays": "^3.1.3",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@folio/eslint-config-stripes": "^7.0.0",
    "@folio/stripes-cli": "^3.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "eslint": "^7.32.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^6.4.4"
  },
  "peerDependencies": {
    "@folio/stripes": ">=9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": ">=6.4.4",
    "react-router-dom": "^5.2.0"
  }
}
