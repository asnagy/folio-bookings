{
  "id": "mod-bookings-bl-@version@",
  "name": "Bookings Business Logic Module",
  "provides": [
    {
      "id": "bookings",
      "version": "1.0",
      "handlers": [
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/bookings/bookings",
          "permissionsRequired": [
            "bookings.bookings.collection.get"
          ],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "bookings-storage.bookings.collection.get",
            "bookings-storage.events.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/bookings/bookings",
          "permissionsRequired": [
            "bookings.bookings.item.post"
          ],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "inventory-storage.holdings.item.get",
            "inventory-storage.instances.item.get",
            "mod-settings.entries.collection.get",
            "mod-settings.global.read.mod-bookings.manage",
            "bookings-storage.bookings.item.get",
            "bookings-storage.bookings.collection.get",
            "bookings-storage.bookings.item.post",
            "bookings-storage.events.collection.get",
            "circulation.requests.item.post"
          ],
          "permissionsDesired": [
            "bookings.override-availability",
            "bookings.override-limit"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/bookings/bookings/{bookingId}",
          "permissionsRequired": [
            "bookings.bookings.item.get"
          ],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "bookings-storage.bookings.item.get",
            "bookings-storage.events.collection.get"
          ]
        },
        {
          "methods": [
            "PUT"
          ],
          "pathPattern": "/bookings/bookings/{bookingId}",
          "permissionsRequired": [
            "bookings.bookings.item.put"
          ],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "inventory-storage.holdings.item.get",
            "inventory-storage.instances.item.get",
            "mod-settings.entries.collection.get",
            "mod-settings.global.read.mod-bookings.manage",
            "bookings-storage.bookings.item.get",
            "bookings-storage.bookings.collection.get",
            "bookings-storage.bookings.item.put",
            "bookings-storage.events.collection.get",
            "circulation.requests.item.post"
          ],
          "permissionsDesired": [
            "bookings.override-availability",
            "bookings.override-limit"
          ]
        },
        {
          "methods": [
            "DELETE"
          ],
          "pathPattern": "/bookings/bookings/{bookingId}",
          "permissionsRequired": [
            "bookings.bookings.item.delete"
          ],
          "modulePermissions": [
            "bookings-storage.bookings.item.get",
            "bookings-storage.bookings.item.delete"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/bookings/bookings/{bookingId}/activate",
          "permissionsRequired": [
            "bookings.bookings.item.activate"
          ],
          "permissionsDesired": [
            "bookings.override-availability"
          ],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "bookings-storage.bookings.item.get",
            "bookings-storage.bookings.item.put",
            "circulation.check-out-by-barcode.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/bookings/events",
          "permissionsRequired": [
            "bookings.events.collection.get"
          ],
          "modulePermissions": [
            "bookings-storage.events.collection.get"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/bookings/events/{eventId}",
          "permissionsRequired": [
            "bookings.events.item.get"
          ],
          "modulePermissions": [
            "bookings-storage.events.item.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/bookings/events",
          "permissionsRequired": [
            "bookings.events.item.post"
          ],
          "modulePermissions": [
            "bookings-storage.events.item.post"
          ]
        },
        {
          "methods": [
            "PUT"
          ],
          "pathPattern": "/bookings/events/{eventId}",
          "permissionsRequired": [
            "bookings.events.item.put"
          ],
          "modulePermissions": [
            "bookings-storage.events.item.put"
          ]
        },
        {
          "methods": [
            "DELETE"
          ],
          "pathPattern": "/bookings/events/{eventId}",
          "permissionsRequired": [
            "bookings.events.item.delete"
          ],
          "modulePermissions": [
            "bookings-storage.events.item.delete"
          ]
        }
      ]
    },
    {
      "id": "_tenant",
      "version": "2.0",
      "interfaceType": "system",
      "handlers": [
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/_/tenant"
        },
        {
          "methods": [
            "GET",
            "DELETE"
          ],
          "pathPattern": "/_/tenant/{id}"
        }
      ]
    },
    {
      "id": "_timer",
      "version": "1.0",
      "interfaceType": "system",
      "handlers": [
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/bookings/scheduled/checkout",
          "unit": "minute",
          "delay": "5",
          "permissionsRequired": [],
          "modulePermissions": [
            "users.item.get",
            "users.collection.get",
            "inventory.items.item.get",
            "inventory.items.collection.get",
            "inventory-storage.holdings.item.get",
            "inventory-storage.instances.item.get",
            "mod-settings.entries.collection.get",
            "mod-settings.global.read.mod-bookings.manage",
            "bookings-storage.bookings.item.get",
            "bookings-storage.bookings.collection.get",
            "bookings-storage.bookings.item.put",
            "circulation.requests.item.post",
            "circulation.check-out-by-barcode.post"
          ]
        }
      ]
    }
  ],
  "requires": [
    {
      "id": "bookings-storage",
      "version": "1.0"
    },
    {
      "id": "circulation",
      "version": "9.0 10.0 11.0 12.0 13.0 14.0"
    },
    {
      "id": "inventory",
      "version": "10.0 11.0 12.0 13.0"
    },
    {
      "id": "users",
      "version": "16.1"
    },
    {
      "id": "loan-storage",
      "version": "7.0"
    },
    {
      "id": "settings",
      "version": "1.1"
    }
  ],
  "permissionSets": [
    {
      "permissionName": "bookings.bookings.collection.get",
      "displayName": "Bookings - get booking collection",
      "description": "Get a list of bookings"
    },
    {
      "permissionName": "bookings.bookings.item.get",
      "displayName": "Bookings - view a booking",
      "description": "View an individual booking record"
    },
    {
      "permissionName": "bookings.bookings.item.post",
      "displayName": "Bookings - create booking",
      "description": "Create a new booking record"
    },
    {
      "permissionName": "bookings.bookings.item.put",
      "displayName": "Bookings - edit booking",
      "description": "Edit an existing booking record"
    },
    {
      "permissionName": "bookings.bookings.item.delete",
      "displayName": "Bookings - delete booking",
      "description": "Delete a booking record"
    },
    {
      "permissionName": "bookings.bookings.item.activate",
      "displayName": "Bookings - manually activate a booking",
      "description": "Manually trigger checkout for all items in a booking"
    },
    {
      "permissionName": "bookings.override-availability",
      "displayName": "Bookings - override item availability",
      "description": "Create a booking for an item regardless of its current loan status"
    },
    {
      "permissionName": "bookings.bookings.view",
      "displayName": "Bookings: View bookings",
      "description": "View-only access to booking records",
      "subPermissions": [
        "bookings.bookings.collection.get",
        "bookings.bookings.item.get",
        "bookings.events.collection.get"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.bookings.create-edit",
      "displayName": "Bookings: Create and edit bookings",
      "description": "Create and edit booking records, including recall triggering",
      "subPermissions": [
        "bookings.bookings.view",
        "bookings.bookings.item.post",
        "bookings.bookings.item.put"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.bookings.delete",
      "displayName": "Bookings: Delete bookings",
      "description": "Delete booking records",
      "subPermissions": [
        "bookings.bookings.item.delete"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.bookings.override-availability",
      "displayName": "Bookings: Override item availability",
      "description": "Allow booking of items regardless of current loan status",
      "subPermissions": [
        "bookings.override-availability"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.events.collection.get",
      "displayName": "Bookings - list events",
      "description": "List events"
    },
    {
      "permissionName": "bookings.events.item.get",
      "displayName": "Bookings - get an event",
      "description": "Get an event"
    },
    {
      "permissionName": "bookings.events.item.post",
      "displayName": "Bookings - create an event",
      "description": "Create an event"
    },
    {
      "permissionName": "bookings.events.item.put",
      "displayName": "Bookings - update an event",
      "description": "Update an event"
    },
    {
      "permissionName": "bookings.events.item.delete",
      "displayName": "Bookings - delete an event",
      "description": "Delete an event"
    },
    {
      "permissionName": "bookings.events.manage",
      "displayName": "Bookings: Manage events",
      "description": "Create, edit and delete events used by bookings",
      "subPermissions": [
        "bookings.events.collection.get",
        "bookings.events.item.get",
        "bookings.events.item.post",
        "bookings.events.item.put",
        "bookings.events.item.delete"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.override-limit",
      "displayName": "Bookings - override booking limit",
      "description": "Create a booking even though the patron has reached their booking limit"
    },
    {
      "permissionName": "bookings.bookings.override-limit",
      "displayName": "Bookings: Override booking limit",
      "description": "Allow bookings beyond the patron group's booking limit",
      "subPermissions": [
        "bookings.override-limit"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.settings.manage",
      "displayName": "Bookings: Manage settings",
      "description": "View and change Bookings settings (limits, recall and checkout timing)",
      "subPermissions": [
        "mod-settings.entries.collection.get",
        "mod-settings.entries.item.get",
        "mod-settings.entries.item.post",
        "mod-settings.entries.item.put",
        "mod-settings.global.read.mod-bookings.manage",
        "mod-settings.global.write.mod-bookings.manage",
        "users.collection.get"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.bookings.activate",
      "displayName": "Bookings: Activate bookings",
      "description": "Manually check out the items of a booking before its start time",
      "subPermissions": [
        "bookings.bookings.item.activate"
      ],
      "visible": true
    },
    {
      "permissionName": "bookings.all",
      "displayName": "Bookings: All permissions",
      "description": "All permissions for the Bookings module",
      "subPermissions": [
        "bookings.bookings.create-edit",
        "bookings.bookings.delete",
        "bookings.bookings.override-availability",
        "bookings.events.manage",
        "bookings.bookings.override-limit",
        "bookings.bookings.activate",
        "bookings.settings.manage"
      ],
      "visible": true
    }
  ],
  "launchDescriptor": {
    "dockerImage": "folioorg/mod-bookings-bl:@version@",
    "dockerPull": false,
    "dockerArgs": {
      "HostConfig": {
        "PortBindings": {
          "8082/tcp": [
            {
              "HostPort": "%p"
            }
          ]
        },
        "Memory": 536870912
      }
    },
    "env": [
      {
        "name": "JAVA_OPTIONS",
        "value": "-XX:MaxRAMPercentage=66.0",
        "description": "JVM options"
      },
      {
        "name": "OKAPI_URL",
        "value": "http://okapi:9130",
        "description": "Okapi gateway URL for cross-module calls"
      }
    ]
  },
  "optional": [
    {
      "id": "holdings-storage",
      "version": "3.0 4.4 5.0 6.0 7.0 8.0"
    },
    {
      "id": "instance-storage",
      "version": "7.0 8.0 9.0 10.0 11.0"
    }
  ]
}
